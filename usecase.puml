@startuml
left to right direction
skinparam packageStyle rectangle
skinparam roundcorner 8
skinparam shadowing false

actor "Quản lý\n(Manager)" as Manager
actor "Nhân viên bán hàng\n(Sales Staff)" as Sales
actor "Nhân viên kỹ thuật\n(Technical Staff)" as Tech
actor "Hệ thống tệp\n(File System)" as Storage

rectangle "HỆ THỐNG QUẢN LÝ XE Ô TÔ ĐIỆN" {

    package "Chung" {
        usecase "Đăng nhập" as UC_Login
        usecase "Tra cứu xe" as UC_Search
    }

    package "Bán hàng" {
        usecase "Quản lý khách hàng" as UC_Customer
        usecase "Lập hợp đồng thuê" as UC_Rent
        usecase "Kiểm tra điều kiện pin & bằng lái" as UC_Check
        usecase "Nhận trả xe & Thanh toán" as UC_Return
    }

    package "Kỹ thuật" {
        usecase "Cảnh báo pin yếu (<20%)" as UC_Alert
        usecase "Thực hiện sạc xe" as UC_Charge
        usecase "Tính tiền nạp điện" as UC_CalcFee
        usecase "Bảo dưỡng xe" as UC_Maintain
    }

    package "Quản trị" {
        usecase "Quản lý đội xe (CRUD)" as UC_ManageCars
        usecase "Quản lý trạm sạc" as UC_ManageStations
        usecase "Xem báo cáo doanh thu" as UC_Report
        usecase "Đọc/Ghi dữ liệu File" as UC_FileIO
    }
}

' Liên kết Actor
Sales --> UC_Login
Sales --> UC_Search
Sales --> UC_Customer
Sales --> UC_Rent
Sales --> UC_Return

Tech --> UC_Login
Tech --> UC_Search
Tech --> UC_Alert
Tech --> UC_Charge
Tech --> UC_Maintain

Manager --> UC_Login
Manager --> UC_Search
Manager --> UC_ManageCars
Manager --> UC_ManageStations
Manager --> UC_Report
Manager --> UC_FileIO

' Quan hệ include / extend
UC_Rent ..> UC_Check : <>
UC_Charge ..> UC_CalcFee : <>
UC_Search <.. UC_Alert : <>
Storage --> UC_FileIO
@enduml
